{
  "name": "mraga",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "npm run build:worklet && vite",
    "build": "npm run build:worklet && tsc -b && vite build",
    "postbuild": "node scripts/stamp-sw-version.mjs",
    "build:worklet": "node scripts/build-worklet.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "vendored:check": "node scripts/sync-vendored.mjs",
    "vendored:sync": "node scripts/sync-vendored.mjs --sync"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
